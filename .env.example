# Generate a fresh value with: go run ./cmd/authctl secret
AUTH_SECRET=
# Optional key ring. The first key is active. Generate each secret independently.
# AUTH_SECRETS=2:<new-secret>,1:<previous-secret>
AUTH_URL=http://127.0.0.1:3000
# Set AUTH_ENV=production to use production defaults.
# AUTH_ENV=development
# Comma-separated additional browser origins, if any
AUTH_TRUSTED_ORIGINS=
# Only the example application uses AUTH_DB.
AUTH_DB=auth.db
# The migration CLI uses AUTH_DSN and a dialect supplied on the command line.
AUTH_DSN=./auth.db
